-- Ultimate Skill premium | UI xanh - đỏ
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- Danh sách remote sẽ bắn khi kích hoạt (theo thứ tự)
local CALLS = {
    { 1, "199" },
    { 2, "Weapons_20_3" },
    { 3, "Weapons_6_1" },
}

local function getRemote()
    return ReplicatedStorage
        :WaitForChild("Network")
        :WaitForChild("PlayerSkillsService")
        :WaitForChild("RE")
        :WaitForChild("SkillSlotChangeSkill")
end

-- Xoá UI cũ nếu chạy lại script
local NAME = "UltimateSkillPremiumUI"
for _, parent in ipairs({ player:FindFirstChild("PlayerGui"), game:GetService("CoreGui") }) do
    local old = parent and parent:FindFirstChild(NAME)
    if old then old:Destroy() end
end

local gui = Instance.new("ScreenGui")
gui.Name = NAME
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local okParent = pcall(function()
    gui.Parent = (gethui and gethui()) or game:GetService("CoreGui")
end)
if not okParent or not gui.Parent then
    gui.Parent = player:WaitForChild("PlayerGui")
end

-- Khung chính (gradient xanh -> đỏ)
local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(240, 136)
main.Position = UDim2.new(0.5, -120, 0.4, 0)
main.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
main.BorderSizePixel = 0
main.Active = true
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 14)

local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 90, 255)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 40, 60)),
})
gradient.Rotation = 25
gradient.Parent = main

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.5
stroke.Thickness = 2
stroke.Parent = main

-- Tiêu đề
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 36)
title.BackgroundTransparency = 1
title.Text = "ULTIMATE SKILL PREMIUM"
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Parent = main

-- Nút kích hoạt
local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -40, 0, 46)
button.Position = UDim2.new(0, 20, 0, 44)
button.BackgroundColor3 = Color3.fromRGB(15, 15, 30)
button.BackgroundTransparency = 0.25
button.Text = "Get 3 skill"
button.Font = Enum.Font.GothamBold
button.TextSize = 18
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.AutoButtonColor = false
button.Parent = main

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)

local btnStroke = Instance.new("UIStroke")
btnStroke.Color = Color3.fromRGB(255, 255, 255)
btnStroke.Transparency = 0.4
btnStroke.Thickness = 1.5
btnStroke.Parent = button

-- Trạng thái
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 22)
status.Position = UDim2.new(0, 0, 0, 100)
status.BackgroundTransparency = 1
status.Text = "Sẵn sàng"
status.Font = Enum.Font.Gotham
status.TextSize = 13
status.TextColor3 = Color3.fromRGB(255, 255, 255)
status.Parent = main

-- Kích hoạt
local busy = false

local function activate()
    if busy then return end
    busy = true
    button.Text = "ĐANG CHẠY..."
    status.Text = "Đang kích hoạt..."

    local ok, err = pcall(function()
        local remote = getRemote()
        for _, args in ipairs(CALLS) do
            remote:FireServer(unpack(args))
            task.wait(0.1)
        end
    end)

    if ok then
        status.Text = "Đã kích hoạt ✓"
    else
        status.Text = "Lỗi: remote không tìm thấy"
        warn("[UltimateSkillPremium]", err)
    end

    task.wait(1)
    button.Text = "KÍCH HOẠT"
    status.Text = "Sẵn sàng"
    busy = false
end

button.MouseButton1Click:Connect(activate)

-- Hiệu ứng nhấn
button.MouseButton1Down:Connect(function()
    TweenService:Create(button, TweenInfo.new(0.1), { BackgroundTransparency = 0.5 }):Play()
end)
button.MouseButton1Up:Connect(function()
    TweenService:Create(button, TweenInfo.new(0.1), { BackgroundTransparency = 0.25 }):Play()
end)

-- Kéo UI (chuột + cảm ứng)
local dragging, dragStart, startPos
main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)
